# Copy to .env and change every value before sharing the machine. Never commit .env.
POSTGRES_PASSWORD=postgres_dev
ICCP_OWNER_PASSWORD=iccp_owner_dev
ICCP_APP_PASSWORD=iccp_app_dev
ICCP_RETENTION_PASSWORD=iccp_retention_dev
ICCP_REPORT_PASSWORD=iccp_report_dev
ICCP_AUDITOR_PASSWORD=iccp_auditor_dev
KEYCLOAK_ADMIN_PASSWORD=admin_dev
MINIO_ROOT_USER=iccp
MINIO_ROOT_PASSWORD=iccp_minio_dev
ICCP_MINIO_BUCKET=iccp
ICCP_MAX_UPLOAD_BYTES=20971520
ICCP_SCAN_MAX_ATTEMPTS=3
# Signs development tokens (dev profile only). At least 32 characters.
ICCP_DEV_SECRET=local-docker-dev-secret-change-me-0123456789
# Host port for the web app. Change it if 8090 is already used by another program or container.
ICCP_WEB_PORT=8090
# Local person-picker sign-in: dev,demo + dev. Shared TIRDO Keycloak: demo + oidc.
ICCP_PROFILES=dev,demo
ICCP_AUTH_MODE=dev
# Browser-visible issuer and Docker-internal signing-key endpoint for shared SSO.
ICCP_OIDC_ISSUER=http://localhost:8180/realms/tirdo
ICCP_OIDC_JWK_SET_URI=http://host.docker.internal:8180/realms/tirdo/protocol/openid-connect/certs
# SMS defaults to a safe logging adapter. For a provider bridge, set provider=http,
# the HTTPS endpoint, and its API key. Never commit a real key.
ICCP_SMS_PROVIDER=log
ICCP_SMS_URL=
ICCP_SMS_API_KEY=
ICCP_SMS_SENDER_ID=TIRDO
ICCP_SMS_CONNECT_TIMEOUT_MS=5000
ICCP_SMS_READ_TIMEOUT_MS=10000
