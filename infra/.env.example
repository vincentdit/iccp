# Copy to .env and change every value before sharing the machine. Never commit .env.
POSTGRES_PASSWORD=postgres_dev
ICCP_OWNER_PASSWORD=iccp_owner_dev
ICCP_APP_PASSWORD=iccp_app_dev
ICCP_RETENTION_PASSWORD=iccp_retention_dev
ICCP_REPORT_PASSWORD=iccp_report_dev
ICCP_AUDITOR_PASSWORD=iccp_auditor_dev
KEYCLOAK_ADMIN_PASSWORD=admin_dev
MINIO_ROOT_USER=iccp
MINIO_ROOT_PASSWORD=iccp_minio_dev
# Signs development tokens (dev profile only). At least 32 characters.
ICCP_DEV_SECRET=local-docker-dev-secret-change-me-0123456789
